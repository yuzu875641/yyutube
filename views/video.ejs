<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link href="https://vjs.zencdn.net/7.20.3/video-js.css" rel="stylesheet" />
    <link rel="stylesheet" href="/style.css">
    <style>
        /* レスポンシブ対応の動画コンテナ */
        .video-container {
            position: relative;
            width: 100%;
            height: 0;
            padding-bottom: 56.25%; /* 16:9のアスペクト比 */
        }
        .video-js {
            position: absolute;
            top: 0;
            left: 0;
            width: 100% !important;
            height: 100% !important;
        }

        /* 既存のレイアウト */
        .page-container {
            display: flex;
            flex-direction: column; /* 小画面では縦並び */
            gap: 20px;
        }

        @media (min-width: 768px) {
            .page-container {
                flex-direction: row; /* 768px以上で横並び */
            }
        }

        .main-content {
            flex-grow: 1;
        }

        .sidebar {
            width: 100%; /* 小画面では幅100% */
        }

        @media (min-width: 768px) {
            .sidebar {
                width: 300px;
            }
        }
    </style>
</head>
<body>
    <a href="/">トップに戻る</a>
    <div class="page-container">
        <div class="main-content">
            <div class="video-container">
                <video
                    id="my-video"
                    class="video-js vjs-default-skin vjs-big-play-centered"
                    controls
                    preload="auto"
                    data-setup="{}"
                >
                    <source src="<%= initialStream.url %>" type="video/mp4">
                    <p class="vjs-no-js">
                        動画を再生するにはJavaScriptを有効にしてください。
                    </p>
                </video>
            </div>

            <div class="quality-select">
                <label for="quality">画質:</label>
                <select id="quality">
                    <% videoStreams.forEach(stream => { %>
                        <option value="<%= stream.url %>" data-resolution="<%= stream.resolution %>">
                            <%= stream.qualityLabel %>
                        </option>
                    <% }); %>
                </select>
            </div>

            <div class="video-details-container">
                <h1><%= videoData.title %></h1>
                <p>投稿者: <a href="/channel?id=<%= videoData.authorId %>"><%= videoData.author %></a></p>
                <p>再生回数: <%= videoData.viewCount %></p>
                <p>公開日: <%= videoData.publishedText %></p>
                <h3>説明</h3>
                <p><%= videoData.description %></p>

                <div class="comment-section">
                    <h3>コメント (<%= commentsData.commentCount || 0 %>)</h3>
                    <% commentsData.comments.forEach(comment => { %>
                        <div class="comment">
                            <div class="comment-author">
                                <img src="<%= comment.authorThumbnails[0].url %>" alt="<%= comment.author %>">
                                <b><%= comment.author %></b>
                            </div>
                            <p><%= comment.content %></p>
                            <small><%= comment.publishedText %> - ❤️ <%= comment.likeCount %></small>
                        </div>
                    <% }); %>
                </div>
            </div>
        </div>

        <div class="sidebar">
            <h3>関連動画</h3>
            <% videoData.recommendedVideos.forEach(video => { %>
                <div class="related-video">
                    <a href="/watch?v=<%= video.videoId %>">
                        <img src="<%= video.videoThumbnails[0].url %>" alt="<%= video.title %>">
                    </a>
                    <div>
                        <a href="/watch?v=<%= video.videoId %>"><h4><%= video.title %></h4></a>
                        <p><%= video.author %></p>
                        <p><%= video.viewCountText %></p>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>

    <script src="https://vjs.zencdn.net/7.20.3/video.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const player = videojs('my-video');
            const qualitySelect = document.getElementById('quality');
            if (qualitySelect) {
                qualitySelect.addEventListener('change', (event) => {
                    const newSourceUrl = event.target.value;
                    const currentTime = player.currentTime();
                    const isPaused = player.paused();
                    player.src({ type: 'video/mp4', src: newSourceUrl });
                    player.ready(() => {
                        player.currentTime(currentTime);
                        if (!isPaused) {
                            player.play();
                        }
                    });
                });
            }
        });
    </script>
</body>
</html>
